{
  "name": "postmaster",
  "version": "1.0.0",
  "description": "A central notification hub that enables applications to broadcast messages across multiple platforms",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:all": "concurrently --names \"SERVER,WORKER\" --prefix-colors \"blue,green\" \"npm run start\" \"npm run worker:prod\"",
    "start:launcher": "node scripts/start-all.js",
    "dev": "nodemon src/server.ts",
    "dev:all": "concurrently --names \"SERVER,WORKER\" --prefix-colors \"blue,green\" \"npm run dev\" \"npm run worker\"",
    "worker": "nodemon src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed-templates": "ts-node scripts/seed-templates.ts",
    "config:validate": "ts-node scripts/validate-config.ts",
    "config:example": "cp config/platforms.example.yml config/platforms.yml",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foyzulkarim/postmaster.git"
  },
  "keywords": [
    "notifications",
    "webhook",
    "slack",
    "discord",
    "telegram",
    "messaging",
    "queue",
    "broadcast"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/foyzulkarim/postmaster/issues"
  },
  "homepage": "https://github.com/foyzulkarim/postmaster#readme",
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.10",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "jest": "^30.0.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.11.1",
    "bullmq": "^5.56.1",
    "dotenv": "^17.0.1",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.11.1",
    "rate-limiter-flexible": "^7.1.1",
    "redis": "^5.5.6",
    "twitter-api-v2": "^1.24.0"
  }
}
